{
  "name": "inlinetex",
  "displayName": "InlineTeX",
  "description": "Édition WYSIWYG en ligne pour LaTeX : formules rendues et mise en forme directement dans l'éditeur, source révélé sous le curseur.",
  "version": "0.2.0",
  "publisher": "yoann-corgnet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoann-CORGNET/InlineTex.git"
  },
  "bugs": {
    "url": "https://github.com/Yoann-CORGNET/InlineTex/issues"
  },
  "homepage": "https://github.com/Yoann-CORGNET/InlineTex#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b2640",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "wysiwyg",
    "math",
    "mathjax",
    "inline preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inlineTeX.toggle",
        "title": "Activer / désactiver le rendu en ligne",
        "category": "InlineTeX"
      },
      {
        "command": "inlineTeX.toggleDocument",
        "title": "Suspendre / reprendre le rendu pour ce fichier",
        "category": "InlineTeX"
      }
    ],
    "keybindings": [
      {
        "command": "inlineTeX.toggle",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && inlineTeX.languageActive"
      }
    ],
    "configuration": {
      "title": "InlineTeX",
      "properties": {
        "inlineTeX.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le rendu en ligne."
        },
        "inlineTeX.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "latex",
            "tex"
          ],
          "description": "Identifiants de langage où le rendu s'applique (ajoutez « markdown » pour les formules $…$ en Markdown)."
        },
        "inlineTeX.renderMath": {
          "type": "boolean",
          "default": true,
          "description": "Remplace les formules ($…$, \\[…\\], equation, align…) par leur rendu."
        },
        "inlineTeX.renderTables": {
          "type": "boolean",
          "default": true,
          "description": "Remplace les tableaux (tabular, tabular*, tabularx) par leur rendu."
        },
        "inlineTeX.renderFormatting": {
          "type": "boolean",
          "default": true,
          "description": "Applique la mise en forme (\\textbf, \\emph, \\section, \\textcolor, \\href…) et remplace \\ref, \\cite, \\label et \\footnote par un texte court, en masquant les commandes."
        },
        "inlineTeX.renderImages": {
          "type": "boolean",
          "default": true,
          "description": "Affiche un aperçu des images de \\includegraphics (PNG, JPEG, GIF, SVG ; pas PDF ni EPS)."
        },
        "inlineTeX.revealOn": {
          "type": "string",
          "enum": [
            "cursor",
            "line"
          ],
          "enumDescriptions": [
            "Le source réapparaît quand le curseur ou la sélection touche l'élément.",
            "Le source réapparaît pour toute la ligne où se trouve le curseur."
          ],
          "default": "cursor",
          "description": "Quand afficher le source LaTeX à la place du rendu."
        },
        "inlineTeX.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "Facteur d'échelle des formules rendues."
        },
        "inlineTeX.color": {
          "type": "string",
          "default": "",
          "description": "Couleur CSS des formules (vide : déduite du thème clair ou sombre)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "lint": "biome lint",
    "test:integration": "node esbuild.mjs --production && node test/integration/run.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
