{
  "name": "inlinetex",
  "displayName": "InlineTeX",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "yoann-corgnet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoann-CORGNET/InlineTex.git"
  },
  "bugs": {
    "url": "https://github.com/Yoann-CORGNET/InlineTex/issues"
  },
  "homepage": "https://github.com/Yoann-CORGNET/InlineTex#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b2640",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "wysiwyg",
    "math",
    "mathjax",
    "inline preview"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "inlineTeX.toggle",
        "title": "%command.toggle%",
        "category": "InlineTeX"
      },
      {
        "command": "inlineTeX.toggleDocument",
        "title": "%command.toggleDocument%",
        "category": "InlineTeX"
      }
    ],
    "keybindings": [
      {
        "command": "inlineTeX.toggle",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && inlineTeX.languageActive"
      }
    ],
    "configuration": {
      "title": "InlineTeX",
      "properties": {
        "inlineTeX.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled.description%"
        },
        "inlineTeX.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "latex",
            "tex"
          ],
          "description": "%config.languages.description%"
        },
        "inlineTeX.renderMath": {
          "type": "boolean",
          "default": true,
          "description": "%config.renderMath.description%"
        },
        "inlineTeX.renderTables": {
          "type": "boolean",
          "default": true,
          "description": "%config.renderTables.description%"
        },
        "inlineTeX.renderFormatting": {
          "type": "boolean",
          "default": true,
          "description": "%config.renderFormatting.description%"
        },
        "inlineTeX.renderImages": {
          "type": "boolean",
          "default": true,
          "description": "%config.renderImages.description%"
        },
        "inlineTeX.revealOn": {
          "type": "string",
          "enum": [
            "cursor",
            "line"
          ],
          "enumDescriptions": [
            "%config.revealOn.cursor%",
            "%config.revealOn.line%"
          ],
          "default": "cursor",
          "description": "%config.revealOn.description%"
        },
        "inlineTeX.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "%config.scale.description%"
        },
        "inlineTeX.color": {
          "type": "string",
          "default": "",
          "description": "%config.color.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "lint": "biome lint",
    "test:integration": "node esbuild.mjs --production && node test/integration/run.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
